{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "react", "nextjs"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "off",
    "react/react-in-jsx-scope": "off",
    "nextjs/no-html-link-for-pages": "off"
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "dist",
    "coverage",
    "next-env.d.ts",
    "pnpm-lock.yaml",
    "apps/api/src/generated",
    "apps/api/dist"
  ]
}
