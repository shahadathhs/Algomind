enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  ADMIN
  PLAYER
}

/// One identity model serves the admin and, later, players (see docs/README_ARCHITECTURE.md).
model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  role               Role           @default(PLAYER)
  mustChangePassword Boolean        @default(false)
  status             UserStatus     @default(ACTIVE)
  /// The name shown on boards, if the player chose one (never the email). Cleared by an admin.
  displayName        String?
  lastActiveAt       DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  refreshTokens      RefreshToken[]
  progress           LevelProgress[]
  playerSettings     PlayerSettings?
  submissions        Submission[]
  pointsLedger       PointsLedger[]
}

/// One row per issued refresh token; only the SHA-256 hash is stored. Tokens that descend from one
/// sign-in share a familyId, so reuse of a rotated token can revoke the whole chain.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}
