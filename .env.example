# Local configuration. `make env` copies this to .env (git-ignored) and fills in a randomly
# generated local database password, so no password is ever stored in the repository.
# Nothing here is a real secret.

# --- Local database (Docker Compose) ---
POSTGRES_USER=algomind
POSTGRES_DB=algomind
POSTGRES_PASSWORD=
# Read by the API and by Prisma on the host. `make env` builds it from the values above.
DATABASE_URL=

# --- API (apps/api) ---
# CORS_ORIGINS=http://localhost:3000
# Added when authentication lands: JWT_SECRET, SUPER_ADMIN_EMAIL, SUPER_ADMIN_PASS

# --- Web (apps/web) ---
# API_BASE_URL=http://localhost:8000/v1
# Public origin for the sitemap and metadata (defaults to the live site; set it for a custom domain):
# SITE_URL=https://playalgomind.vercel.app
# GitHub Releases source for the download page (defaults shown). The token is optional and server-side only;
# anonymous visitors still cannot download assets from a private repository.
# GITHUB_REPOSITORY=shahadathhs/Algomind
# GITHUB_TOKEN=
# Only for testing or GitHub Enterprise; leave unset to use api.github.com:
# GITHUB_API_URL=https://api.github.com
