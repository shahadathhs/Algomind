# Copy to .env (git-ignored) and fill in. Nothing here is a real secret.
# Each app documents the variables it reads; this file lists the shared ones.

# --- API (apps/api) ---
# DATABASE_URL=postgresql://algomind:algomind@localhost:5432/algomind
# JWT_SECRET=change-me-to-a-long-random-string
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASS=change-me-before-first-run
# CORS_ORIGINS=http://localhost:3000

# --- Web (apps/web) ---
# API_BASE_URL=http://localhost:8000/v1
